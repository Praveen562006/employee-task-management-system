# --- Database ---
# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/employee_db
# Local development without Docker (SQLite fallback, no setup needed):
# DATABASE_URL=sqlite:///./employee.db
DATABASE_URL=sqlite:///./employee.db

# --- Security (JWT) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
